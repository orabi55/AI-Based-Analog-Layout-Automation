# ─────────────────────────────────────────────────────
#  API Keys — copy this file to .env and fill in yours
# ─────────────────────────────────────────────────────

# Google Gemini (primary — recommended)
GEMINI_API_KEY=

# Groq (free tier, fast — get key at https://console.groq.com)
GROQ_API_KEY=

# OpenAI (optional fallback)
OPENAI_API_KEY=

# DeepSeek (optional fallback)
DEEPSEEK_API_KEY=

# Anthropic (optional)
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────
#  Custom Compiler SSH Deploy (one-click export button)
# ─────────────────────────────────────────────────────
CC_SSH_HOST=your.server.hostname
CC_SSH_USER=your_username
CC_SSH_PASSWORD=your_password
# Remote directory where the schematic/layout lives (no trailing slash)
CC_REMOTE_DIR=/home/your_username/designs/your_cell
